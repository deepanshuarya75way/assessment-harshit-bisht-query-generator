# Which LLM generates the SQL: "ollama" (free, local) or "anthropic" (paid API)
LLM_PROVIDER=ollama

# --- Ollama settings (only used if LLM_PROVIDER=ollama) ---
# Install from https://ollama.com, then: ollama pull qwen2.5-coder
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# --- Anthropic settings (only used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Path to the SQLite database file that will be queried
DATABASE_PATH=./sample.db

# Safety limits
MAX_ROWS_RETURNED=500
QUERY_TIMEOUT_SECONDS=5
